# Postgres database for funds, stocks, and index history.
# Prefer the Supabase session pooler (port 5432). Do not use the direct host or Transaction mode (6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Same URL, used by Alembic so market-data migrations are not applied to SQLite.
ALEMBIC_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Local portfolio ledger. This file stays on this computer.
PORTFOLIO_SQLITE_URL=sqlite+aiosqlite:///./portfolio-service/portfolio.db

# Signs the local login cookie. Generate a new value; do not reuse this placeholder.
SESSION_SECRET=replace-with-a-long-random-string

# ExchangeRate-API key for Home USD/INR (https://www.exchangerate-api.com/).
EXCHANGE_RATE_API_KEY=

# --- Multi-client E2E vault (optional; see docs/design/) ---
# PC talks to Supabase via DATABASE_URL (session pooler above) for market_data + portfolio_vault.
PORTFOLIO_ENCRYPTION_SECRET=replace-with-long-random-secret
VAULT_USER_ID=00000000-0000-0000-0000-000000000001

# Android setup uses a *separate* restricted session-pooler URI (market read-only role).
# Do not put this PC DATABASE_URL into the Android app. See supabase/android_readonly_role.sql.

# GitHub Actions market refresh uses a *third* URI (gha_market_writer) stored only as
# repo secret MARKET_DATABASE_URL — never commit it here. See supabase/gha_market_writer.sql.
