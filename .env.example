# Postgres database for funds, stocks, and index history.
# Use the session-pooler URL from Supabase, or any Postgres you already have.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Same URL, used by Alembic so market-data migrations are not applied to SQLite.
ALEMBIC_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Local portfolio ledger. This file stays on this computer.
PORTFOLIO_SQLITE_URL=sqlite+aiosqlite:///./portfolio-service/portfolio.db

# Signs the local login cookie. Generate a new value; do not reuse this placeholder.
SESSION_SECRET=replace-with-a-long-random-string
